<?xml version="1.0" encoding="utf-8"?>
<!-- The schedule widget (docs/plans/android.md#D317): the month and "+"
     over the days ahead, which scroll freely (`ScheduleService`'s rows). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/widget_ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 48dp to touch, the pill 40dp within it; named in the app's
             language once the app hands a snapshot, in the system's before. -->
        <ImageView
            android:id="@+id/widget_create"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_create_inset"
            android:contentDescription="@string/widget_create"
            android:scaleType="center"
            android:src="@drawable/widget_add" />
    </LinearLayout>

    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingBottom="12dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/widget_open_app"
        android:textColor="@color/widget_muted"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
