<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the schedule widget: the day's date (beside its first row,
     today's in a circle), then the item filled in its colour. The date's
     size is in dp, as it fills a circle of a fixed size; the item's text
     grows with the user's font size, and its card with it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Room above a day's first row (a FrameLayout: a widget inflates no plain View). -->
    <FrameLayout
        android:id="@+id/row_gap"
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/row_day"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:importantForAccessibility="yes">

            <ImageView
                android:id="@+id/row_today"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal|top"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_today" />

            <LinearLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal|top"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/row_weekday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textSize="12dp"
                    tools:ignore="SpUsage" />

                <TextView
                    android:id="@+id/row_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textSize="18dp"
                    tools:ignore="SpUsage" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/row_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:minHeight="40dp">

            <ImageView
                android:id="@+id/row_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_row_shape" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:id="@+id/row_mark"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:id="@+id/row_badge"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_badge"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/row_check"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_check" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/row_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/row_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
