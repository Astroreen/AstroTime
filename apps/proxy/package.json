{
  "name": "@astrotime/proxy",
  "version": "0.0.0",
  "private": true,
  "description": "The web app's server: its static files and the CalDAV proxy, in one Docker image (docs/plans/foundation.md#D20)",
  "type": "module",
  "scripts": {
    "build": "vp build",
    "compress": "node src/compress.ts ../web/dist",
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrotime/caldav": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite": "catalog:"
  }
}
