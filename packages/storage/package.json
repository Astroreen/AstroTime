{
  "name": "@astrotime/storage",
  "version": "0.0.0",
  "private": true,
  "description": "The local store: one SQLite schema behind a driver per platform",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./src/node.ts"
    },
    "./web": {
      "types": "./src/web/index.ts",
      "import": "./src/web/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p test"
  },
  "dependencies": {
    "@astrotime/core": "workspace:*",
    "@sqlite.org/sqlite-wasm": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
