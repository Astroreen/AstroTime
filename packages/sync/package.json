{
  "name": "@astrotime/sync",
  "version": "0.0.0",
  "private": true,
  "description": "The sync engine: reconciles the local store with a provider",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./calendars": {
      "types": "./src/calendars.ts",
      "import": "./src/calendars.ts"
    },
    "./files": {
      "types": "./src/files.ts",
      "import": "./src/files.ts"
    },
    "./people": {
      "types": "./src/people.ts",
      "import": "./src/people.ts"
    },
    "./subscriptions": {
      "types": "./src/subscriptions.ts",
      "import": "./src/subscriptions.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p test"
  },
  "dependencies": {
    "@astrotime/caldav": "workspace:*",
    "@astrotime/core": "workspace:*",
    "@astrotime/ics": "workspace:*",
    "@astrotime/storage": "workspace:*"
  },
  "devDependencies": {
    "@astrotime/server": "workspace:*",
    "@types/node": "catalog:"
  }
}
